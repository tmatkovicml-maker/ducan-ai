# Copy to .env and fill in. Never commit .env.

# Random string, at least 32 characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Argon2 hash of the shared admin password (min. 14 characters).
# Generate with: make hash-password
# Keep the hash in single quotes so the "$" characters stay literal: ADMIN_PASSWORD_HASH='$argon2id$...'

ADMIN_PASSWORD_HASH=

DATABASE_URL=sqlite:///data/ducan.sqlite3
CONFIG_DIR=config
BRAND_DIR=brand
DATA_DIR=data

# Set to false only for local development over plain http.
COOKIE_SECURE=true

# Used from Phase 2 on. The model name is never hard-coded.
ANTHROPIC_API_KEY=
# e.g. claude-opus-5-5. Empty = no LLM calls (template texts are used instead).
ANTHROPIC_MODEL=

# Domain served by Caddy (automatic HTTPS) in docker-compose.
DOMAIN=localhost

# Optional server-side refusal fallback for the model above ("default" or empty).
ANTHROPIC_REFUSAL_FALLBACK=default
# Optional effort level (low | medium | high | xhigh | max). Empty = model default.
ANTHROPIC_EFFORT=low

# SMTP for sending approved purchase orders. If SMTP_HOST is empty, approved orders
# stay "approved" and the order sheet can be downloaded and sent by hand.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# TTF font with Croatian characters for PDF order sheets.
PDF_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# Where alerts for the owner are emailed (e.g. a missing rota on Thursday).
OWNER_EMAIL=
# Public address of this app, used in links sent to staff (e.g. https://ducan.example.hr).
PUBLIC_BASE_URL=

# Websites allowed to use the chat widget, comma-separated (e.g. https://www.ducan.hr).
CHAT_ALLOWED_ORIGINS=
